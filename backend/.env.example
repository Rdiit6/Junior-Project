# ClimaPulse environment template — copy to .env and fill in real values.
# Do NOT commit the real .env file.

# Open-Meteo does not require an API key for non-commercial use.
# Optional overrides for the two Open-Meteo hosts (live data and history).
# The double underscore maps to the "OpenMeteo" config section (see OpenMeteoOptions.cs).
# Defaults are built into the code, so these lines are only needed to change them.
OpenMeteo__ForecastBaseUrl=https://api.open-meteo.com/v1/forecast
OpenMeteo__ArchiveBaseUrl=https://archive-api.open-meteo.com/v1/archive

# Local SQLite database file path
CLIMAPULSE_DB_PATH=climapulse.db
