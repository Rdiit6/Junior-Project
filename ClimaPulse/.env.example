# ClimaPulse environment template — copy to .env and fill in real values.
# Do NOT commit the real .env file.

# Open-Meteo does not require an API key for non-commercial use.
# These are placeholders for optional overrides / future use.
OPENMETEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Local SQLite database file path
CLIMAPULSE_DB_PATH=climapulse.db
